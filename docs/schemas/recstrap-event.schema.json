{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrapEvent",
  "description": "One line of `recstrap --json`, in order: `start`, `progress` (repeated),\n`verify`, `done`. `recstrap --check --json` prints one `checked` instead.",
  "oneOf": [
    {
      "description": "Every check passed; nothing was copied (`--check`).",
      "type": "object",
      "properties": {
        "checks": {
          "description": "How many checks ran (waived ones are not counted).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "event": {
          "type": "string",
          "const": "checked"
        },
        "free_bytes": {
          "description": "Free space on the target's filesystem.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rootfs": {
          "type": "string"
        },
        "rootfs_bytes": {
          "description": "The image file's size.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "schema_version",
        "target",
        "rootfs",
        "rootfs_bytes",
        "free_bytes",
        "checks"
      ]
    },
    {
      "description": "The copy begins: the image is mounted and its entries counted.",
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "start"
        },
        "rootfs": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "target": {
          "type": "string"
        },
        "total_bytes": {
          "description": "The size of its regular files.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_entries": {
          "description": "Files, directories and links in the image, below its top directory.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "event",
        "schema_version",
        "target",
        "rootfs",
        "total_entries",
        "total_bytes"
      ]
    },
    {
      "description": "Copied so far: entries counted from the copy, bytes from the target's\nfilesystem (allocated space, so it can run past `total_bytes`).",
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "entries": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "event": {
          "type": "string",
          "const": "progress"
        }
      },
      "required": [
        "event",
        "entries",
        "bytes"
      ]
    },
    {
      "description": "The copy finished; the extracted system is being checked.",
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "verify"
        }
      },
      "required": [
        "event"
      ]
    },
    {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "entries": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "event": {
          "type": "string",
          "const": "done"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "event",
        "schema_version",
        "entries",
        "bytes",
        "duration_ms"
      ]
    }
  ]
}
